# Локальные переменные. Скопируй в .env и заполни.
# Файл .env в репозиторий не коммитится.

# Ключ подписи серверных сессий Next.js, 32 случайных байта в base64.
# openssl rand -base64 32
SESSION_SECRET=

# Идентификатор проекта Microsoft Clarity (clarity.microsoft.com).
# Пусто — счётчик не подключается.
NEXT_PUBLIC_CLARITY_ID=

# Идентификатор пикселя Meta. Пусто — пиксель не подключается.
NEXT_PUBLIC_FB_PIXEL_ID=

# Контейнер Google Tag Manager (через него Google Analytics). Пусто — не подключается.
NEXT_PUBLIC_GTM_ID=

# Google Analytics 4, идентификатор потока G-…. Пусто — не подключается.
NEXT_PUBLIC_GA_ID=
