NEXT_PUBLIC_API_URL=https://crysshop.kz
NEXT_PUBLIC_TELEGRAM_BOT_NAME=crysShop_bot
# Microsoft Clarity: записи сессий и карты кликов. Идентификатор проекта берётся
# на clarity.microsoft.com, у магазина он должен быть СВОЙ — счётчик primelegal.kz
# (v6vu0lbwj7) сюда подставлять нельзя, иначе данные двух сайтов смешаются.
# Пусто = счётчик не грузится. Значение подставляется на сборке образа.
NEXT_PUBLIC_CLARITY_ID=y5py5i1mpv
# Пиксель Meta (Ads Manager → Events Manager). Наш пиксель магазина.
# До 24.08.2026 в layout.tsx был зашит чужой пиксель, доступа к нему нет.
NEXT_PUBLIC_FB_PIXEL_ID=309925558692805
# Google Tag Manager магазина, через него подключена Google Analytics.
# Стоял в старом .NET-шаблоне с 31.12.2023 (I_STORE, коммит e7c7f05) и при
# переезде витрины на Next.js не перенёсся. Пусто = контейнер не грузится.
# ВЫКЛЮЧЕН 07.10.2026: в GTM-NBXQDRZN нет тега Google Analytics, единственный
# тег — пиксель Meta 896757741855213, которого нет ни в одном нашем репозитории.
# Включать обратно только после того, как в контейнер добавят тег GA4
# и уберут оттуда этот пиксель.
NEXT_PUBLIC_GTM_ID=
